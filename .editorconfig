root = true

[*]
charset = utf-8

trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

[*.java]
indent_style = tab
indent_size = 4
ij_continuation_indent_size = 4

[*.yml]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2

[*.json]
indent_style = tab
indent_size = 4

[*.nix]
indent_style = space
indent_size = 2